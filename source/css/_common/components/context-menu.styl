.context-menu {
  --context-menu-bg: rgba(251, 253, 248, .96);
  --context-menu-border: rgba(56, 161, 219, .2);
  --context-menu-divider: rgba(56, 161, 219, .14);
  --context-menu-hover: rgba(56, 161, 219, .1);
  --context-menu-icon: #777d7d;
  --context-menu-text: var(--grey-7);

  position: fixed;
  z-index: $zindex-5 + 10;
  box-sizing: border-box;
  width: calc(100vw - 1rem);
  max-width: 17.25rem;
  max-height: calc(100vh - 1rem);
  padding: .625rem;
  overflow-x: hidden;
  overflow-y: auto;
  color: var(--context-menu-text);
  background: var(--context-menu-bg);
  border: .0625rem solid var(--context-menu-border);
  border-radius: 1.25rem;
  box-shadow: 0 .75rem 2.5rem rgba(36, 45, 50, .16), 0 0 0 .0625rem rgba(255, 255, 255, .35) inset;
  backdrop-filter: blur(1.125rem) saturate(135%);
  -webkit-backdrop-filter: blur(1.125rem) saturate(135%);
  opacity: 0;
  transform: translateY(-.375rem) scale(.98);
  transform-origin: top left;
  transition: opacity .14s ease, transform .14s ease;
  user-select: none;

  &[hidden] {
    display: none !important;
  }

  &.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  svg {
    width: 1.375rem;
    height: 1.375rem;
    flex: 0 0 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .context-menu-emoji {
    width: 1.375rem;
    flex: 0 0 1.375rem;
    font-size: 1.25rem;
    line-height: 1;
    text-align: center;
    filter: grayscale(.15);
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }
}

.context-menu-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .5rem;

  button,
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 0;
    height: 3.25rem;
    padding: 0;
    color: var(--context-menu-icon);
    background: transparent;
    border: .0625rem solid var(--context-menu-divider);
    border-radius: 1rem;
    cursor: pointer;
    outline: none;
    transition: color .15s ease, background-color .15s ease, border-color .15s ease, transform .15s ease;

    &:hover,
    &:focus-visible {
      color: var(--color-blue);
      background: var(--context-menu-hover);
      border-color: var(--context-menu-border);
    }

    &:active {
      transform: scale(.94);
    }
  }
}

.context-menu-divider {
  height: .0625rem;
  margin: .5rem 0;
  background: repeating-linear-gradient(90deg, var(--context-menu-divider) 0, var(--context-menu-divider) .1875rem, transparent .1875rem, transparent .375rem);
}

.context-menu-list {
  display: flex;
  flex-direction: column;
}

.context-menu-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 3.125rem;
  box-sizing: border-box;
  padding: .625rem .75rem;
  gap: .875rem;
  color: var(--context-menu-text);
  background: transparent;
  border: 0;
  border-radius: .75rem;
  font: inherit;
  font-size: 1rem;
  line-height: 1.4;
  text-align: left;
  text-decoration: none;
  cursor: pointer;
  outline: none;
  transition: color .15s ease, background-color .15s ease, transform .15s ease;

  svg {
    color: var(--context-menu-icon);
    transition: color .15s ease;
  }

  &:hover,
  &:focus-visible {
    color: var(--color-blue);
    background: var(--context-menu-hover);
    text-decoration: none;

    svg {
      color: var(--color-blue);
    }
  }

  &:active {
    transform: scale(.985);
  }

  &[hidden] {
    display: none !important;
  }
}

.context-menu-bomb {
  &:hover,
  &:focus-visible {
    color: var(--color-orange);
    background: rgba(236, 140, 105, .12);
  }
}

[data-theme="dark"] .context-menu {
  --context-menu-bg: rgba(19, 24, 32, .96);
  --context-menu-border: rgba(56, 161, 219, .28);
  --context-menu-divider: rgba(135, 146, 155, .18);
  --context-menu-hover: rgba(56, 161, 219, .14);
  --context-menu-icon: #aeb5ba;
  --context-menu-text: #e6e9eb;

  box-shadow: 0 .875rem 2.75rem rgba(0, 0, 0, .45), 0 0 0 .0625rem rgba(255, 255, 255, .025) inset;
}

@media (prefers-reduced-motion: reduce) {
  .context-menu,
  .context-menu-nav button,
  .context-menu-nav a,
  .context-menu-item {
    transition: none;
  }
}

+mobile-small() {
  .context-menu {
    max-width: 16.5rem;
    padding: .5rem;
    border-radius: 1rem;
  }

  .context-menu-nav {
    gap: .375rem;

    button,
    a {
      height: 3rem;
      border-radius: .875rem;
    }
  }

  .context-menu-item {
    min-height: 2.875rem;
    padding: .5rem .625rem;
    font-size: .9375rem;
  }
}
