<%
const normalizeFeedCodeBlocks = (content = '') => content.replace(
  /<figure class="highlight(?:\s+([^"]+))?">([\s\S]*?)<\/figure>/gi,
  (figure, language, body) => {
    const captionMatch = body.match(/<figcaption\b[^>]*>([\s\S]*?)<\/figcaption>/i);
    const caption = captionMatch
      ? captionMatch[1].replace(/<[^>]+>/g, '').trim()
      : '';
    const lines = [];

    body.replace(/<pre>([\s\S]*?)<\/pre>/gi, (pre, line) => {
      lines.push(line);
      return pre;
    });

    if (!lines.length) return figure;

    const safeLanguage = String(language || '')
      .split(/\s+/)[0]
      .replace(/[^\w-]/g, '');
    const languageClass = safeLanguage
      ? ` class="language-${safeLanguage}"`
      : '';
    const captionHtml = caption ? `<p><em>${caption}</em></p>` : '';

    return `${captionHtml}<pre><code${languageClass}>${lines.join('\n')}</code></pre>`;
  }
);

const stripFeedKatexHtml = (content = '') => {
  const marker = '<span class="katex-html"';
  const spanTag = /<\/?span\b[^>]*>/gi;
  let result = '';
  let cursor = 0;

  while (cursor < content.length) {
    const start = content.indexOf(marker, cursor);
    if (start === -1) {
      result += content.slice(cursor);
      break;
    }

    result += content.slice(cursor, start);

    const openingTagEnd = content.indexOf('>', start);
    if (openingTagEnd === -1) {
      result += content.slice(start);
      break;
    }

    let depth = 1;
    spanTag.lastIndex = openingTagEnd + 1;
    let match;

    while (depth > 0 && (match = spanTag.exec(content))) {
      if (match[0].startsWith('</')) {
        depth -= 1;
      } else if (!match[0].endsWith('/>')) {
        depth += 1;
      }
    }

    if (depth > 0) {
      result += content.slice(start);
      break;
    }

    cursor = spanTag.lastIndex;
  }

  return result;
};

const normalizeFeedContent = (content = '') => stripFeedKatexHtml(
  normalizeFeedCodeBlocks(content)
);
%><?xml version="1.0"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <id><%= config.url %></id>
    <title><%= config.title %></title>
    <subtitle><%= config.subtitle %></subtitle>
    <icon><%= full_url_for('/images/favicon.ico') %></icon>
    <link href="<%= config.url %>" />
    <author>
      <name><%= config.author %></name>
    </author>
    <updated><%= moment(lastBuildDate).toISOString() %></updated>
    <%_ for (item of (config.keywords ? config.keywords.split(',') : [])) { _%>
    <category term="<%= item %>" />
    <%_ } _%>
    <%_ for (const post of posts) { _%>
    <entry>
        <id><%= post.permalink %></id>
        <title><%= post.title %></title>
        <link rel="alternate" href="<%= post.permalink %>"/>
        <content type="html"><%= normalizeFeedContent(post.content) %></content>
        <%_ for (const { name, path } of (post.categories ? post.categories.toArray() : [])) { _%>
        <category term="<%= name %>" scheme="<%= full_url_for(path) %>" />
        <%_ } _%>
        <%_ for (const { name, path } of (post.tags ? post.tags.toArray() : [])) { _%>
        <category term="<%= name %>" scheme="<%= full_url_for(path) %>" />
        <%_ } _%>
        <updated><%= moment(post.date).toISOString() %></updated>
    </entry>
    <%_ } _%>
</feed>
